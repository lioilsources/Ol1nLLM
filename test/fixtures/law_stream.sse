data: {"done": true, "sources": [{"work": "262/2006 Sb.", "name_cs": "Zákon č. 262/2006 Sb., zákoník práce", "title": "262/2006 Sb. (§ 51 odst. 1–3)", "group": "pracovni_socialni", "lang": "cs", "path": "/sb/2006/262/2026-08-29", "distance": 0.6721, "excerpt": "§ 51\n(1) Byla-li dána výpověď, skončí pracovní poměr uplynutím výpovědní doby. Výpovědní doba začíná dnem, v němž byla výpověď doručena druhé smluvní straně, a končí dnem, který se s tímto dnem…", "work_id": "cz.sb.2006.262", "chapter_id": "cz.sb.2006.262:0067", "chapter_path": "ČÁST DRUHÁ PRACOVNÍ POMĚR › HLAVA IV SKONČENÍ PRACOVNÍHO POMĚRU › Díl 3 Výpověď, výpovědní doba a výpovědní důvody › Oddíl 1 Výpověď › § 51", "ref_start": "§ 51 odst. 1", "ref_end": "§ 51 odst. 3", "lang_original": "cs", "lang_corpus": "cs", "score": 0.01639, "channels": ["vec"]}, {"work": "262/2006 Sb.", "name_cs": "Zákon č. 262/2006 Sb., zákoník práce", "title": "262/2006 Sb. (§ 58 odst. 1–2)", "group": "pracovni_socialni", "lang": "cs", "path": "/sb/2006/262/2026-08-29", "distance": 0.6774, "excerpt": "§ 58\n(1) Pro porušení povinnosti vyplývající z právních předpisů vztahujících se k vykonávané práci nebo z důvodu, pro který je možné okamžitě zrušit pracovní poměr, může dát zaměstnavatel…", "work_id": "cz.sb.2006.262", "chapter_id": "cz.sb.2006.262:0079", "chapter_path": "ČÁST DRUHÁ PRACOVNÍ POMĚR › HLAVA IV SKONČENÍ PRACOVNÍHO POMĚRU › Díl 5 Společná ustanovení o rozvázání pracovního poměru › § 58", "ref_start": "§ 58 odst. 1", "ref_end": "§ 58 odst. 2", "lang_original": "cs", "lang_corpus": "cs", "score": 0.01613, "channels": ["vec"]}, {"work": "262/2006 Sb.", "name_cs": "Zákon č. 262/2006 Sb., zákoník práce", "title": "262/2006 Sb. (§ 51a odst. 1–2)", "group": "pracovni_socialni", "lang": "cs", "path": "/sb/2006/262/2026-08-29", "distance": 0.6825, "excerpt": "§ 51a\n(1) Byla-li výpověď ze strany zaměstnance dána z důvodu přechodu práv a povinností z pracovněprávních vztahů nebo z důvodu přechodu výkonu práv a povinností z pracovněprávních vztahů do 15 dnů…", "work_id": "cz.sb.2006.262", "chapter_id": "cz.sb.2006.262:0068", "chapter_path": "ČÁST DRUHÁ PRACOVNÍ POMĚR › HLAVA IV SKONČENÍ PRACOVNÍHO POMĚRU › Díl 3 Výpověď, výpovědní doba a výpovědní důvody › Oddíl 1 Výpověď › § 51a", "ref_start": "§ 51a odst. 1", "ref_end": "§ 51a odst. 2", "lang_original": "cs", "lang_corpus": "cs", "score": 0.01587, "channels": ["vec"]}, {"work": "262/2006 Sb.", "name_cs": "Zákon č. 262/2006 Sb., zákoník práce", "title": "262/2006 Sb. (§ 63)", "group": "pracovni_socialni", "lang": "cs", "path": "/sb/2006/262/2026-08-29", "distance": 0.6875, "excerpt": "§ 63\nPracovní poměr hromadně propouštěného zaměstnance skončí výpovědí nejdříve po uplynutí doby 30 dnů po sobě jdoucích od doručení písemné zprávy zaměstnavatele podle § 62 odst. 5 krajské pobočce…", "work_id": "cz.sb.2006.262", "chapter_id": "cz.sb.2006.262:0085", "chapter_path": "ČÁST DRUHÁ PRACOVNÍ POMĚR › HLAVA IV SKONČENÍ PRACOVNÍHO POMĚRU › Díl 6 Hromadné propouštění › § 63", "ref_start": "§ 63", "ref_end": "§ 63", "lang_original": "cs", "lang_corpus": "cs", "score": 0.01562, "channels": ["vec"]}, {"work": "262/2006 Sb.", "name_cs": "Zákon č. 262/2006 Sb., zákoník práce", "title": "262/2006 Sb. (§ 72)", "group": "pracovni_socialni", "lang": "cs", "path": "/sb/2006/262/2026-08-29", "distance": 0.6923, "excerpt": "§ 72\nNeplatnost rozvázání pracovního poměru výpovědí, okamžitým zrušením, zrušením ve zkušební době nebo dohodou může jak zaměstnavatel, tak i zaměstnanec uplatnit u soudu nejpozději ve lhůtě 2…", "work_id": "cz.sb.2006.262", "chapter_id": "cz.sb.2006.262:0097", "chapter_path": "ČÁST DRUHÁ PRACOVNÍ POMĚR › HLAVA IV SKONČENÍ PRACOVNÍHO POMĚRU › Díl 9 Neplatné rozvázání pracovního poměru › § 72", "ref_start": "§ 72", "ref_end": "§ 72", "lang_original": "cs", "lang_corpus": "cs", "score": 0.01538, "channels": ["vec"]}, {"work": "262/2006 Sb.", "name_cs": "Zákon č. 262/2006 Sb., zákoník práce", "title": "262/2006 Sb. (§ 57 odst. 1–2)", "group": "pracovni_socialni", "lang": "cs", "path": "/sb/2006/262/2026-08-29", "distance": 0.697, "excerpt": "§ 57\n(1) Pro porušení jiné povinnosti zaměstnance stanovené v § 301a zvlášť hrubým způsobem [§ 52 písm. h)] může dát zaměstnavatel zaměstnanci výpověď pouze do 1 měsíce ode dne, kdy se o tomto důvodu…", "work_id": "cz.sb.2006.262", "chapter_id": "cz.sb.2006.262:0078", "chapter_path": "ČÁST DRUHÁ PRACOVNÍ POMĚR › HLAVA IV SKONČENÍ PRACOVNÍHO POMĚRU › Díl 5 Společná ustanovení o rozvázání pracovního poměru › § 57", "ref_start": "§ 57 odst. 1", "ref_end": "§ 57 odst. 2", "lang_original": "cs", "lang_corpus": "cs", "score": 0.01515, "channels": ["vec"]}, {"work": "89/2012 Sb.", "name_cs": "Zákon č. 89/2012 Sb., občanský zákoník", "title": "89/2012 Sb. (§ 1999 odst. 1–2)", "group": "obcanske", "lang": "cs", "path": "/sb/2012/89/2026-01-01", "distance": 0.726, "excerpt": "§ 1999 Výpověď\n(1) Zavazuje-li smlouva ujednaná na dobu neurčitou alespoň jednu stranu k nepřetržité nebo opakované činnosti, anebo zavazuje-li alespoň jednu stranu takovou činnost strpět, lze…", "work_id": "cz.sb.2012.89", "chapter_id": "cz.sb.2012.89:2241", "chapter_path": "ČÁST ČTVRTÁ RELATIVNÍ MAJETKOVÁ PRÁVA › HLAVA I VŠEOBECNÁ USTANOVENÍ O ZÁVAZCÍCH › Díl 7 Zánik závazků › Oddíl 2 Jiné způsoby zániku závazků › § 1999 Výpověď", "ref_start": "§ 1999 odst. 1", "ref_end": "§ 1999 odst. 2", "lang_original": "cs", "lang_corpus": "cs", "score": 0.0137, "channels": ["vec"]}, {"work": "89/2012 Sb.", "name_cs": "Zákon č. 89/2012 Sb., občanský zákoník", "title": "89/2012 Sb. (§ 2310 odst. 1–2)", "group": "obcanske", "lang": "cs", "path": "/sb/2012/89/2026-01-01", "distance": 0.7333, "excerpt": "§ 2310 Skončení nájmu\n(1) Ve výpovědi musí být uveden její důvod; výpověď, v níž není uveden její důvod, je neplatná.\n(2) Výpovědní doba je tříměsíční.", "work_id": "cz.sb.2012.89", "chapter_id": "cz.sb.2012.89:2579", "chapter_path": "ČÁST ČTVRTÁ RELATIVNÍ MAJETKOVÁ PRÁVA › HLAVA II ZÁVAZKY Z PRÁVNÍCH JEDNÁNÍ › Díl 2 Přenechání věci k užití jinému › Oddíl 3 Nájem › Pododdíl 3 Zvláštní ustanovení o nájmu prostoru sloužícího podnikání Základní ustanovení › § 2310 Skončení nájmu", "ref_start": "§ 2310 odst. 1", "ref_end": "§ 2310 odst. 2", "lang_original": "cs", "lang_corpus": "cs", "score": 0.01333, "channels": ["vec"]}], "routed": {"works": [], "groups": [], "channels": ["vec"], "intent": "content"}, "session_id": "1104978f-970e-44e0-a610-8cb3c3b545c3", "model": "translate", "intent": "content", "plan": {"intent": "content", "groups": [], "topics": [], "author": null, "lang": null, "work_hint": null, "chapter_hint": null, "detail": "auto", "group_by": "none", "terms_orig": {}, "model": "", "cached": false, "ms": 0}}

