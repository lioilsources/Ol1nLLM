{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Qwen-Image diffusion model" },
    "inputs": {
      "unet_name": "qwen_image_fp8_e4m3fn.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen2.5-VL text encoder" },
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Qwen-Image VAE" },
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "4": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "Shift" },
    "inputs": { "shift": 3.1, "model": ["1", 0] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive prompt" },
    "inputs": { "text": "__PROMPT__", "clip": ["2", 0] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative prompt" },
    "inputs": { "text": "__NEGATIVE__", "clip": ["2", 0] }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "Empty latent (batch)" },
    "inputs": { "width": 1328, "height": 1328, "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "filename_prefix": "ol1n_qwen", "images": ["9", 0] }
  }
}
