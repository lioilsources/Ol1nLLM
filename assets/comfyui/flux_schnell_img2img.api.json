{
  "10": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load FLUX schnell UNET (bf16 file, fp8 in memory)" },
    "inputs": {
      "unet_name": "flux1-schnell.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "_meta": { "title": "Load FLUX CLIP (T5 + CLIP-L)" },
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "12": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load FLUX VAE" },
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "14": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive prompt (schnell: no FluxGuidance, distilled)" },
    "inputs": {
      "text": "__PROMPT__",
      "clip": ["11", 0]
    }
  },
  "15": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative (unused on FLUX, kept for CFG=1)" },
    "inputs": {
      "text": "",
      "clip": ["11", 0]
    }
  },
  "30": {
    "class_type": "LoadImage",
    "_meta": { "title": "Load uploaded image" },
    "inputs": {
      "image": "__IMAGE__",
      "upload": "image"
    }
  },
  "31": {
    "class_type": "ImageScaleToTotalPixels",
    "_meta": { "title": "Scale source to ~1 MP, sides multiple of 16 (FLUX patch)" },
    "inputs": {
      "image": ["30", 0],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 16
    }
  },
  "32": {
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode (img2img)" },
    "inputs": {
      "pixels": ["31", 0],
      "vae": ["12", 0]
    }
  },
  "33": {
    "class_type": "RepeatLatentBatch",
    "_meta": { "title": "Repeat latent → batch" },
    "inputs": {
      "amount": 4,
      "samples": ["32", 0]
    }
  },
  "18": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (denoise < 1, patched by the app)" },
    "inputs": {
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.75,
      "model": ["10", 0],
      "positive": ["14", 0],
      "negative": ["15", 0],
      "latent_image": ["33", 0]
    }
  },
  "19": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["18", 0],
      "vae": ["12", 0]
    }
  },
  "20": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": {
      "filename_prefix": "ol1n_schnell_edit",
      "images": ["19", 0]
    }
  }
}
